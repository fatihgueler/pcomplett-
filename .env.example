# -----------------------------------------------------------------------------
# Umgebungsvariablen – Kopie als .env.local (lokal) bzw. in den Vercel-
# Projekteinstellungen (Produktion) hinterlegen. Niemals echte Keys committen.
# -----------------------------------------------------------------------------

# KI-Chatbot (Claude API) -----------------------------------------------------
# Ohne diesen Key zeigt das Chat-Widget einen freundlichen Hinweis statt Fehler.
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben (Standard: claude-sonnet-4-6)
# CHATBOT_MODEL=

# Kontaktformular / Ticketsystem ---------------------------------------------
# Aktuell ist ein Mock-Adapter aktiv (lib/tickets.ts). Sobald ein Ticketsystem
# (Zammad/Freshdesk/osTicket) gewählt ist, hier die Zugangsdaten ergänzen, z.B.:
# TICKET_PROVIDER=zammad
# ZAMMAD_URL=
# ZAMMAD_TOKEN=

# Optionaler E-Mail-Versand (Kontakt) ----------------------------------------
# RESEND_API_KEY=
# CONTACT_EMAIL=

# Kontakt-E-Mail (it-Adresse) für die Kontaktseite ---------------------------
# Wird nur als Bild dargestellt (Spam-Schutz). Bild unter
# /public/kontakt/email-kontakt.svg mit der echten it-Adresse ersetzen.
# KONTAKT_EMAIL={{KONTAKT_EMAIL}}

# Ticketsystem (Kontaktformular -> Ticket) -----------------------------------
# TICKET_API_URL={{TICKET_API_URL}}
# TICKET_API_KEY={{TICKET_API_KEY}}

# Rückrufservice -------------------------------------------------------------
# Zielsystem noch offen (Ticket / interne Benachrichtigung).
# RUECKRUF_WEBHOOK_URL={{RUECKRUF_WEBHOOK_URL}}

# Cloudflare Turnstile (Captcha, DSGVO-freundlich) ---------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY={{TURNSTILE_SITE_KEY}}
# TURNSTILE_SECRET_KEY={{TURNSTILE_SECRET_KEY}}
